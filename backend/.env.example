# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/race?retryWrites=true&w=majority

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_RESEND_ATTEMPTS=3
OTP_MAX_VERIFY_ATTEMPTS=5

# CORS
CORS_ORIGIN=*

# Google Cloud Storage (future)
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_KEY_FILE=

# App — use your PC LAN IP in dev so phone QR scans reach the API (same as EXPO_PUBLIC_API_URL)
APP_BASE_URL=http://192.168.1.7:3000
